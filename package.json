{
  "name": "diskbytes-license-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DiskBytes licensing backend — Cloudflare Worker + D1: key registry, device binding (1 Windows + 1 macOS per key), Ed25519-signed entitlement tokens, 24 h revalidation, revocation, admin API.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/seed-local.mjs",
    "gen:keypair": "node scripts/generate-keypair.mjs",
    "gen:secret": "node scripts/generate-secret.mjs",
    "gen:keys": "node scripts/generate-keys.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20250901.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.42.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260926.1": true
  }
}
